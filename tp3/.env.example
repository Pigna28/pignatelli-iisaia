# local: demostración sin identidad real, exclusivamente en loopback.
# auth0: autenticación real; completar las variables siguientes.
AUTH_MODE=local
APP_ENV=development
BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/lab.db
SESSION_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Identificadores sub de Auth0, separados por coma. Vacío = todos solo lectura.
WRITE_SUBJECTS=
